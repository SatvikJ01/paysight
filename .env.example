# Copy to .env and fill in. .env is gitignored; never commit real keys.
#
# With no API key set, Paysight runs in `replay` mode from the committed cassettes,
# so the demo and the evaluation work out of the box.

# Which LLM provider to use: gemini | anthropic | openai | fake
LLM_PROVIDER=anthropic
# Model name for the chosen provider. Leave empty to use the provider default in config/settings.yaml
# (gemini-3.8-flash, claude-sonnet-5-5 or gpt-5-mini).
LLM_MODEL=
# live | record | replay. Leave empty for automatic: replay when no key is set, live otherwise.
LLM_MODE=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Set to 1 for JSON-formatted logs.
PAYSIGHT_LOG_JSON=0
# Optional: override the repository root that holds config/, data/ and cassettes/.
PAYSIGHT_ROOT=
